#!/usr/bin/env bash
# run-skills bin/run-launch — launch the project's run on a nohup workstation target, contained (env.sh) and
# detached. Runs LOCALLY from the repo root (cwd with .ws.conf) after run-sync + run-bootstrap.
#   TARGET=<name> bash ~/.agents/run-skills/bin/run-launch [-d 0,1 | -n 2] [-N name] [--nice N] [--same-name-ok]
#                 [--gpu-busy-ok] [--rs-attempt NONCE] [--rs-mode plan] [--rs-expect HASH [--rs-warnings N]] [-- <run cmd...>]
#     -d ids   use exactly these GPU ids (bypasses GPU_EXCLUDE)     -n N   auto-pick the N idlest free GPUs (memory.used)
#     -N name  job/log name (default: JOB_NAME, else the remote dir basename)   -- cmd   overrides RUN from .ws.conf
#     --nice N  the run's nice level 0-19 (default: NICE from .ws.conf)
#     --same-name-ok  launch even if a run of this name from this project is alive (else exit 6)
#     --gpu-busy-ok   launch onto GPUs with a compute process (else -d onto one = exit 6; auto-pick skips them)
#     --rs-attempt NONCE  the attempt id ([A-Za-z0-9][A-Za-z0-9._-]{0,63}; default: generated) — reusing one exits 75, never relaunches
#     --rs-mode plan / --rs-expect HASH [--rs-warnings N]  rsk's protocol (api=3): print the @@plan block, start nothing /
#              launch only that plan, with as many WARNING: lines as its card counted
# Driven by rsk (`rsk launch`, which sets RS_VIA_RSK=1): called directly while rsk is installed (on PATH, or in uv's
# tool bin dir) it points there and exits 2; installed without rsk it launches, with a NOTE. .ws.conf keys (generic or <TAG>_): RUN DEFAULT_NGPU
# GPU_EXCLUDE NICE JOB_NAME ENV_NAME; generic-only: ENV_KIND.
# Prints the GPU table (one read-only ssh), then ONE ssh runs the deployed .ws/launch.sh (pick, env gate, receipt in
# <REMOTE_DIR>/.rs/attempts/<NONCE>/, setsid). Log: <REMOTE_DIR>/logs/<name>-<timestamp>.log (+ .pid, .rc). Exit: launch.sh's
# (0 launched/planned, 1 failed, 2 usage, 6 same name alive / busy -d GPU / not the plan, 75 NONCE claimed) or ssh's 255.
# STATION= / CLUSTER= are aliases of TARGET=.
set -euo pipefail
RS_HOME=$(cd "$(dirname "$0")/.." && pwd)
. "$RS_HOME/lib/common.sh"
rs_init
rsk_installed() {   # rsk on PATH, or in uv's tool bin dir (uv tool install puts it there; that dir may not be on PATH)
  command -v rsk >/dev/null 2>&1 && return 0
  command -v uv >/dev/null 2>&1 || return 1
  local d; d=$(uv tool dir --bin 2>/dev/null) && [ -n "$d" ] && [ -x "$d/rsk" ]
}
if [ "$T_KIND" != nohup ]; then
  if rsk_installed; then die "run-launch is for nohup targets; $T_NAME is Slurm: rsk launch -T $T_NAME … -- <cmd> (plan → the user's words → submit)"
  else die "run-launch is for nohup targets; $T_NAME is Slurm: its deployed submit.sh (references/procedure-slurm.md)"; fi
fi
if [ -z "${RS_VIA_RSK:-}" ]; then   # P7: steer a direct call to rsk's plan → approval → launch flow (a nudge, not a guard)
  if rsk_installed; then
    echo "use: rsk launch -T $T_NAME … (plan → the user's words → submit) — nothing launched" >&2; exit 2; fi
  echo "NOTE: run-skills is installed without rsk: run-launch launches directly — the user's go comes first" >&2
fi
rs_load_conf REMOTE_DIR WS_REMOTE_DIR ENV_NAME ENV_KIND ENV_HOOK WANDB_MODE DEFAULT_NGPU GPU_EXCLUDE NICE RUN JOB_NAME
RDIR=$(rs_remote_dir); HOST=$T_HOST
ENV_NAME=$(ovr ENV_NAME); DEF_NGPU=$(ovr DEFAULT_NGPU 1); GPUX=$(ovr GPU_EXCLUDE); NICE=$(ovr NICE); RUN=$(ovr RUN)
NAME=$(ovr JOB_NAME "$(basename "$RDIR")")
case "${ENV_KIND:-uv}" in uv|conda|none) ;; *) die "ENV_KIND must be uv|conda|none (got '${ENV_KIND:-}')" ;; esac
[ "${ENV_KIND:-uv}" != conda ] || [ -n "$ENV_NAME" ] || die "ENV_NAME required in .ws.conf for ENV_KIND=conda"
GPUX="${GPUX//[[:space:]]/}"     # '0, 1' -> '0,1' (else the exclude regex silently fails open)
if [ -n "$GPUX" ] && ! printf %s "$GPUX" | grep -Eq '^[0-9]+(,[0-9]+)*$'; then
  die "GPU_EXCLUDE must be comma-separated GPU ids (got '$GPUX')"
fi

GPUS=""; NPICK=""; NONCE=""; SAME=""; BOK=""; PLAN=""; EXPECT=""; RSW=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -d) GPUS="${2:?-d needs GPU ids}"; shift 2 ;;
    -n) NPICK="${2:?-n needs a count}"; shift 2 ;;
    -N) NAME="${2:?-N needs a name}"; shift 2 ;;
    --nice) NICE="${2:?--nice needs a value}"; shift 2 ;;
    --same-name-ok) SAME=1; shift ;;
    --gpu-busy-ok) BOK=1; shift ;;
    --rs-attempt) NONCE="${2:?--rs-attempt needs a value}"; shift 2 ;;
    --rs-mode) [ -z "$PLAN" ] && [ "${2:-}" = plan ] || die "--rs-mode takes one value, plan, once"; PLAN=1; shift 2 ;;
    --rs-expect) h=${2:-}; [ -z "$EXPECT" ] && [ "${#h}" = 64 ] && [ -n "${h##*[!0123456789abcdef]*}" ] || die "--rs-expect takes one bound_hash (64 lowercase hex), once"
                 EXPECT=$h; shift 2 ;;
    --rs-warnings) h=${2:-}; [ -z "$RSW" ] && [ -n "$h" ] && [ -n "${h##*[!0123456789]*}" ] || die "--rs-warnings takes one count (digits), once"
                   RSW=$h; shift 2 ;;
    --) shift; break ;;
    *) echo "unknown arg: $1 (usage: run-launch [-d ids | -n N] [-N name] [--nice N] [--same-name-ok] [--gpu-busy-ok] [--rs-attempt NONCE] [--rs-mode plan] [--rs-expect HASH [--rs-warnings N]] -- <cmd>)" >&2; exit 2 ;;
  esac
done
if [ -n "$NICE" ] && ! printf %s "$NICE" | grep -Eq '^[0-9]+$'; then   # --nice beats the conf's NICE
  die "NICE must be a non-negative integer 0-19 (got '$NICE')"   # negative nice = priority over other users
fi
# -d gets the same normalise+validate as GPU_EXCLUDE: a space inside CUDA_VISIBLE_DEVICES silently pins fewer GPUs.
if [ -n "$GPUS" ]; then
  GPUS="${GPUS//[[:space:]]/}"
  printf %s "$GPUS" | grep -Eq '^[0-9]+(,[0-9]+)*$' || die "-d must be comma-separated GPU ids (got '$GPUS')"
fi
RUN_CMD="$*"; [ -n "$RUN_CMD" ] || RUN_CMD="$RUN"
[ -n "$RUN_CMD" ] || die "no run command (pass after -- or set RUN / ${T_TAG}_RUN in .ws.conf)"
case "$NAME" in ''|.*|-*|*/*|*\'*|*[[:space:]]*|*[[:cntrl:]]*) die "-N / JOB_NAME '$NAME': a run name is one word, no / or ' (letters, digits, . _ - …)" ;; esac
if [ -n "$NONCE" ]; then   # the remote claim refuses anything else; checked here so nothing is sent
  AN=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789   # spelled out (ranges follow the locale), as submit.sh
  case "$NONCE" in [!$AN]*|*[!$AN._-]*) die "--rs-attempt must match [A-Za-z0-9][A-Za-z0-9._-]{0,63} (got '$NONCE')" ;; esac
  [ "${#NONCE}" -le 64 ] || die "--rs-attempt must be at most 64 characters"
else NONCE="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"; fi

sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }   # one word for the remote shell
echo "[$T_NAME] current GPUs on $HOST:"
ssh "$HOST" "nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,memory.total --format=csv,noheader" | sed 's/^/  /'
if [ -n "$GPUS" ]; then
  PICK="-d $(sq "$GPUS")"
  if [ -n "$NPICK" ]; then   # fewer GPUs than confirmed would silently change the run (world size, batch math)
    got=$(printf %s "$GPUS" | tr ',' '\n' | grep -c .)
    [ "$got" -ge "$NPICK" ] || { echo "ERROR: asked -n $NPICK but only $got GPU id(s) given with -d. Use -n $got or more -d ids." >&2; exit 1; }
  fi
else
  [ -n "$NPICK" ] || NPICK="$DEF_NGPU"
  printf %s "$NPICK" | grep -Eq '^[1-9][0-9]*$' \
    || die "GPU count (-n / DEFAULT_NGPU) must be a positive integer (got '$NPICK')"   # GNU head -n -1 = all but last
  [ -z "$GPUX" ] || echo "[$T_NAME] auto-pick excludes GPU(s) [$GPUX] (GPU_EXCLUDE)"
  PICK="-n $(sq "$NPICK")"; [ -z "$GPUX" ] || PICK="$PICK -x $(sq "$GPUX")"
fi
LOG="logs/${NAME}-$(date +%Y%m%d-%H%M%S).log"   # timestamped: a re-run with the same -N never truncates an older log
echo "[$T_NAME] reference: $(rs_ref) — the target rules: re-read before the next plan unless verbatim in your context"

# ONE ssh: the deployed .ws/launch.sh picks + maps the GPUs, gates on env.sh, refuses a live same-name run, records the
# attempt (.rs/attempts/<NONCE>/) and setsid's the run; it prints only when everything is recorded. RUN goes as ONE
# word, single-quoted for the remote shell, and launch.sh parses it once — as the old inline chain did.
ARGS="--rs-attempt $(sq "$NONCE") -N $(sq "$NAME") --log $(sq "$LOG") $PICK"
[ -z "$NICE" ] || ARGS="$ARGS --nice $(sq "$NICE")"
[ -z "$SAME" ] || ARGS="$ARGS --same-name-ok"; [ -z "$BOK" ] || ARGS="$ARGS --gpu-busy-ok"
[ -z "$PLAN" ] || ARGS="$ARGS --rs-mode plan"; [ -z "$EXPECT" ] || ARGS="$ARGS --rs-expect $EXPECT"   # (an old launch.sh: exit 2)
[ -z "$RSW" ] || ARGS="$ARGS --rs-warnings $RSW"
rc=0
ssh "$HOST" "cd $(sq "$RDIR") || exit 1; test -f .ws/launch.sh || { echo 'ERROR: no .ws/launch.sh in the remote dir: the deploy predates it — run run-sync first' >&2; exit 2; }; \
TARGET=$(sq "$T_NAME") bash .ws/launch.sh $ARGS -- $(sq "$RUN_CMD")" || rc=$?
if [ "$rc" = 255 ] && [ -n "$PLAN" ]; then echo "NOTE: ssh failed (exit 255) during a plan: nothing was launched (a plan never starts a run)" >&2
elif [ "$rc" = 255 ]; then
  echo "NOTE: ssh failed (exit 255): the launch may or may not have happened. Before any retry: ssh $HOST \"cat '$RDIR/.rs/attempts/$NONCE/result'\" (verdict=…; no such file = not started or still starting). Retrying with --rs-attempt $NONCE can never launch twice (exit 75 = that attempt already ran)." >&2
fi
[ "$rc" = 0 ] || exit "$rc"
[ -z "$PLAN" ] || exit 0
echo "[$T_NAME] verify:  ssh $HOST \"bash '$RDIR/.ws/status.sh' '$LOG'\"   |   ssh $HOST \"nvidia-smi\""   # log relative to the project: status.sh resolves it
